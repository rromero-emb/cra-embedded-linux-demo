# ======================= Sesión 4: arranque verificado ======================
# El device tree de control lo entrega la etapa anterior (QEMU -dtb, como TF-A en hardware
# real) y contiene la clave pública. u-boot.bin + ese device tree = firmware de confianza.

# Solo imágenes FIT con firma válida. Sin formato legacy ni arranque directo de un Image.
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_RSA=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_BOOTZ is not set

# Orden de arranque y parámetros del kernel COMPILADOS en el entorno por defecto
# (board/qemu-aarch64-cra/uboot-env.txt, lógica A/B). Sin bootstd: U-Boot no busca
# ni ejecuta boot.scr/extlinux.conf en el disco.
# CONFIG_BOOTSTD_BOOTCOMMAND is not set
# CONFIG_BOOTSTD_DEFAULTS is not set
# CONFIG_BOOTSTD_MENU is not set
# CONFIG_CMD_BOOTFLOW is not set
# CONFIG_CMD_BOOTDEV is not set
# CONFIG_CMD_BOOTMETH is not set

# Entorno solo en memoria: nada en disco/flash que un atacante pueda modificar.
# (El estado A/B se importa con lista blanca desde bootstate.txt, ver uboot-env.txt)
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FLASH is not set

# Sin pausa ni posibilidad de interrumpir el arranque; si ningún slot verifica, se apaga.
CONFIG_BOOTDELAY=-2
CONFIG_CMD_POWEROFF=y

# KASLR: U-Boot inyecta una kaslr-seed nueva en cada arranque desde virtio-rng.
CONFIG_DM_RNG=y
CONFIG_VIRTIO_RNG=y

# ======================= Sesión 3: superficie mínima ========================
# Sin pila de red en U-Boot (arranca desde disco).
CONFIG_NO_NET=y
# CONFIG_NET is not set
# Herramienta de cápsulas EFI: no se usa y en 2026.07 exige GnuTLS con PKCS#11
# CONFIG_TOOLS_MKEFICAPSULE is not set


# ======================= Sesión 5: arranque A/B ============================
# Entorno por defecto desde fichero (lógica A/B). Ojo: U-Boot renombró la opción
# (antes USE_DEFAULT_ENV_FILE) y la opción de Buildroot 2025.02 usa el nombre viejo,
# que se ignora en silencio. Ruta relativa al árbol de U-Boot (output/build/uboot-*).
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="../../../br2-external/board/qemu-aarch64-cra/uboot-env.txt"

# Sesión 6: lectura en bruto del FIT del slot
CONFIG_CMD_READ=y
